[core]
  excludesfile = ~/.gitignore_global
  fsmonitor = true
[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[merge]
  tool = vscode
[mergetool "vscode"]
  cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[mergetool]
  keepBackup = false
[push]
  autoSetupRemote = true
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
[alias]
  prune-old = "!~/.config/git/scripts/git-prune-old"
  prune-old-force = "!~/.config/git/scripts/git-prune-old-force"
  recent = "!~/.config/git/scripts/git-recent"
[advice]
  skippedCherryPicks = false
