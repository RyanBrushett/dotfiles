new-tmux () {
  if (( $# > 1 )); then
    echo "usage: new-tmux [session-name]" >&2
    return 1
  fi

  local session_name="${1:-default}"
  tmux new-session -n shell -s "$session_name"
}

# Watch a hunk diff against a base branch.
# Usage: hdw [base-branch]   (default: repo's actual default branch, freshly fetched)
#
# No argument: syncs the detected default branch from origin first, since you
# always want that comparison to be current. An explicit argument (e.g. a stack
# parent) is used as-is with no fetch, since that's usually a local branch you're
# actively working on rather than something to pull from origin.
hdw () {
  if (( $# > 1 )); then
    echo "usage: hdw [base-branch]" >&2
    return 1
  fi

  local base="$1"

  if [[ -z "$base" ]]; then
    base=$(git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null | sed 's|origin/||')
    base="${base:-main}"
    git fetch origin "$base" || return 1
    base="origin/$base"
  fi

  local merge_base
  merge_base=$(git merge-base "$base" HEAD) || return 1

  hunk diff --watch "$merge_base"
}

# Reset kube context and namespace to the local rancher-desktop cluster.
# Re-reads the live config afterwards rather than trusting exit codes, and
# shouts if kubectl ends up anywhere other than rancher-desktop/default.
kuberst () {
  local want_context="rancher-desktop"
  local want_namespace="default"

  kubectl config use-context "$want_context" >/dev/null &&
    kubectl config set-context --current --namespace="$want_namespace" >/dev/null

  local context namespace
  context=$(kubectl config current-context 2>/dev/null)
  namespace=$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null)
  # An unset namespace on a context means kubectl falls back to "default".
  namespace="${namespace:-default}"

  if [[ "$context" != "$want_context" || "$namespace" != "$want_namespace" ]]; then
    printf '\e[1;41;97m %s \e[0m\n' "KUBERST FAILED" >&2
    printf '\e[1;31mkubectl is pointing at context: %s\e[0m\n' "${context:-<unknown>}" >&2
    printf '\e[1;31mnamespace: %s\e[0m\n' "$namespace" >&2
    return 1
  fi

  printf '\e[32mkubectl -> %s/%s\e[0m\n' "$context" "$namespace"
}

btooth () {
  if command -v blueutil &> /dev/null; then
    blueutil -p 0
    sleep 1
    blueutil -p 1
  else
    echo "blueutil is not installed"
  fi
}
